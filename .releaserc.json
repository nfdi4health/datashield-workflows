{
  "branches": "main",
  "tagFormat": "${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "NEWS.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "Rscript -e 'desc::desc_set_version(version = \"${nextRelease.version}\")'"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "*.json",
          "DESCRIPTION",
          "NEWS.md"
        ],
        "message": "chore(release): set Description file and NEWS.md to ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
